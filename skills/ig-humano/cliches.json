      "fix": "O Instagram limita a 5 desde dez/2025. Use 3 a 5 específicas."
    },
    {
      "id": "sou-ia",
      "regex": "(?i)\\bcomo (?:uma )?(?:ia|intelig[eê]ncia artificial|modelo de linguagem)\\b",
      "name": "Autorreferência de IA",
      "fix": "Apague a frase."
    },
    {
      "id": "em-suma",
      "regex": "(?im)^\\s*(?:em suma|em resumo|em conclus[aã]o|para concluir|resumindo)\\b",
      "name": "Abertura de conclusão de redação",
      "fix": "Post não precisa de parágrafo de conclusão."
    },
    {
      "id": "isca-generica",
      "regex": "(?i)\\b(?:concorda\\?|o que voc[eê]s? acha(?:m)?\\?|quem mais\\b|estou errad[oa]\\?)\\s*$",
      "name": "Isca de engajamento genérica",
      "fix": "Faça uma pergunta que só você faria, sobre o assunto do post."
    },
    {
      "id": "para-de-rolar",
      "regex": "(?im)^\\s*(?:para de rolar|pare de rolar|n[aã]o passa|espera,? n[aã]o)\\b",
