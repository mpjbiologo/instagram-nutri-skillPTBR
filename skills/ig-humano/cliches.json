    {
      "id": "nao-e-so",
      "regex": "(?i)\\bn[aã]o [eé] (?:s[oó]|apenas|somente) [^.!?\\n]{2,60}[,.;] [eé]\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diga só o que você quer dizer. Apague a metade de preparação."
    },
    {
      "id": "nao-apenas",
      "regex": "(?i)\\bn[aã]o (?:apenas|s[oó]|somente)\\b[^.!?\\n]{2,80}\\bmas (?:tamb[eé]m|sim)\\b",
      "name": "\"Não apenas X, mas também Y\"",
      "fix": "Divida em duas frases ou corte a metade mais fraca."
    },
    {
      "id": "nao-e-sobre",
      "regex": "(?i)\\bn[aã]o [eé] sobre [^.!?\\n]{2,60}[.!,] [eé] sobre\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Comece pelo Y. A virada é o sinal de texto de IA."
    },
    {
      "id": "pergunta-retorica",
      "regex": "(?im)^\\s*(?:o resultado|a melhor parte|o detalhe|o segredo|o problema|a verdade|e o pior)\\?\\s*$",
      "name": "Linha de pergunta retórica (\"O resultado?\")",
      "fix": "Responda direto, sem encenar revelação."
    },
    {
      "id": "aqui-esta",
      "regex": "(?i)\\b(?:aqui est[aá] o que eu aprendi|o que eu aprendi com isso|vou te contar o que aprendi)\\b",
      "name": "\"Aqui está o que eu aprendi\"",
      "fix": "Diga a lição. Pule o anúncio."
    },
    {
      "id": "trio",
      "regex": "(?i)\\b[\\wÀ-ÿ]+, [\\wÀ-ÿ]+ e [\\wÀ-ÿ]+\\.",
      "name": "Trio de três palavras",
      "fix": "Duas ou quatro. Três é o ritmo padrão de IA."
    },
    {
      "id": "emoji-foguete",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1✨\\U0001F3AF\\U0001F4AA\\U0001F64C]",
      "name": "Emoji foguete / fogo / lâmpada / brilho / alvo / braço / mãos",
      "fix": "No máximo um emoji, e não destes."
    },
    {
      "id": "muro-hashtag",
      "regex": "(?:#[\\wÀ-ÿ]+[ \\t]*){6,}",
